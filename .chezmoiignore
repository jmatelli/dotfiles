# Bootstrap/helper scripts live in the repo but are not applied into $HOME.
install.sh
setup-secrets.sh
docker-smoke-test.sh
docker-smoke-test/
README.md
CHANGELOG.md
# OpenCode config for working on this repo (its GitHub MCP server), not ~/opencode.json.
opencode.json
docs
docs/**

# TPM manages its own plugins (clones them on demand via prefix+I) - not
# chezmoi's job, and several of these are nested git checkouts.
.config/tmux/plugins/**

# tmux is only for the Linux profiles; Herdr is the terminal on macOS.
{{ if eq .chezmoi.os "darwin" -}}
.config/tmux
.config/tmux/**
{{ end -}}

# npm-managed, regenerated from package-lock.json.
.config/opencode/node_modules/**

# OpenCode background-service credentials (hardcoded password) - machine-local.
.config/opencode/service.json

# Herdr background originals: full-size photos (tens of MB) that
# herdr-backgrounds prepares into backgrounds/rotation, which is in the repo.
.config/herdr-app/backgrounds/originals
.config/herdr-app/backgrounds/originals/**

# Herdr is macOS-only here: its helper only makes sense there (its launchd
# agent is written by run_onchange_after_36-herdr-panes, also macOS-only).
{{ if ne .chezmoi.os "darwin" -}}
.local/bin/herdr-panes
{{ end -}}

# termscp bookmarks keep hosts and usernames in plain text: never add them
# to this public repo.
.config/termscp
.config/termscp/**
