#!/usr/bin/env bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
# Write and (re)load the launchd agent that runs `herdr-panes tick`, so Herdr
# panes get their programs back after a reboot. launchd only loads user agents
# from ~/Library/LaunchAgents, so the plist has to live there; this script
# writes it from .chezmoitemplates/herdr-panes.plist instead of chezmoi
# managing it. The plist is part of this script, so the script reruns whenever
# the template changes.
plist="$HOME/Library/LaunchAgents/local.herdr-panes.plist"
mkdir -p "$(dirname "$plist")" "$HOME/.local/state"
cat > "$plist" <<'PLIST'
{{ template "herdr-panes.plist" . -}}
PLIST
domain="gui/$(id -u)"
launchctl bootout "$domain/local.herdr-panes" 2>/dev/null || true
launchctl bootstrap "$domain" "$plist" || echo "Warning: failed to load $plist" >&2
{{ end -}}
