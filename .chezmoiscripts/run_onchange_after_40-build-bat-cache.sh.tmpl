#!/usr/bin/env bash
set -euo pipefail

# bat only sees custom themes in ~/.config/bat/themes after its cache is
# rebuilt. chezmoi reruns this whenever a theme file changes:
# themes hash: {{ include "dot_config/bat/themes/tokyonight_night.tmTheme" | sha256sum }}
if command -v bat >/dev/null 2>&1; then
  bat cache --build
fi
