---
description: >-
  Security audit (Opus, read-only, runs gitleaks/trivy/dependency audits). Use when the user asks for
  a security audit, pentest-style review, threat model, or "is this secure?", or for a secrets or
  vulnerable-dependency check, of the current change, a path, or the whole repo. Not a replacement
  for code-reviewer/deep-reviewer on everyday changes.
mode: subagent
model: claude-agent/opus
permissions:
  # Deny everything (edits, web, MCP, subagents), then allow reading and the
  # scanner list. It reads secrets and untrusted code: nowhere to send them.
  - action: "*"
    resource: "*"
    effect: deny
  - action: read
    resource: "*"
    effect: allow
  - action: read
    resource: "*.env"
    effect: deny
  - action: read
    resource: "*.env.*"
    effect: deny
  - action: read
    resource: "*.env.example"
    effect: allow
  - action: glob
    resource: "*"
    effect: allow
  - action: grep
    resource: "*"
    effect: allow
  # git diff / log / show, minus flags that write files or run programs, and
  # minus git's global options (-c diff.external=…, --git-dir…). No git -C:
  # a glob can't keep it to one word; cd dir && git log works instead.
  - action: shell
    resource: "git diff *"
    effect: allow
  - action: shell
    resource: "git log *"
    effect: allow
  - action: shell
    resource: "git show *"
    effect: allow
  - action: shell
    resource: "*--output*"
    effect: deny
  - action: shell
    resource: "*--ext-diff*"
    effect: deny
  - action: shell
    resource: "*--textconv*"
    effect: deny
  - action: shell
    resource: "git * -O*"
    effect: deny
  - action: shell
    resource: "git * -c *"
    effect: deny
  - action: shell
    resource: "*--config-env*"
    effect: deny
  - action: shell
    resource: "*--git-dir*"
    effect: deny
  - action: shell
    resource: "*--work-tree*"
    effect: deny
  - action: shell
    resource: "*--exec-path*"
    effect: deny
  - action: shell
    resource: "*--namespace*"
    effect: deny
  - action: shell
    resource: "*GIT_*"
    effect: deny
  # Scanners: the fixed prefix, then only plain paths. Any later argument
  # starting with - is denied, so no flag can write a report, load config,
  # change the output or reach the network. trivy gets --config /dev/null
  # so a trivy.yaml in the audited repo is ignored.
  - action: shell
    resource: "gitleaks dir --redact --no-banner *"
    effect: allow
  - action: shell
    resource: "gitleaks dir --redact --no-banner -*"
    effect: deny
  - action: shell
    resource: "gitleaks dir --redact --no-banner * -*"
    effect: deny
  - action: shell
    resource: "gitleaks git --redact --no-banner *"
    effect: allow
  - action: shell
    resource: "gitleaks git --redact --no-banner -*"
    effect: deny
  - action: shell
    resource: "gitleaks git --redact --no-banner * -*"
    effect: deny
  - action: shell
    resource: "trivy fs --config /dev/null --scanners vuln,misconfig,secret --quiet *"
    effect: allow
  - action: shell
    resource: "trivy fs --config /dev/null --scanners vuln,misconfig,secret --quiet -*"
    effect: deny
  - action: shell
    resource: "trivy fs --config /dev/null --scanners vuln,misconfig,secret --quiet * -*"
    effect: deny
  - action: shell
    resource: "semgrep scan --metrics=off --config p/default --quiet *"
    effect: allow
  - action: shell
    resource: "semgrep scan --metrics=off --config p/default --quiet -*"
    effect: deny
  - action: shell
    resource: "semgrep scan --metrics=off --config p/default --quiet * -*"
    effect: deny
  - action: shell
    resource: "zizmor --offline --no-progress *"
    effect: allow
  - action: shell
    resource: "zizmor --offline --no-progress -*"
    effect: deny
  - action: shell
    resource: "zizmor --offline --no-progress * -*"
    effect: deny
  - action: shell
    resource: "govulncheck ./..."
    effect: allow
  # Dependency audits in fixed forms, like the Claude hook. They still run
  # the repo's yarn (.yarnrc.yml yarnPath) and .npmrc: the prompt says when
  # to skip them. govulncheck -C and npm audit --prefix reach a module or
  # package below the repo root.
  - action: shell
    resource: "yarn audit"
    effect: allow
  - action: shell
    resource: "yarn npm audit"
    effect: allow
  - action: shell
    resource: "yarn npm audit --all"
    effect: allow
  - action: shell
    resource: "yarn npm audit --recursive"
    effect: allow
  - action: shell
    resource: "yarn npm audit --all --recursive"
    effect: allow
  - action: shell
    resource: "npm audit"
    effect: allow
  - action: shell
    resource: "npm audit --omit=dev"
    effect: allow
  - action: shell
    resource: "npm audit --prefix *"
    effect: allow
  - action: shell
    resource: "npm audit --prefix -*"
    effect: deny
  - action: shell
    resource: "npm audit --prefix * -*"
    effect: deny
  - action: shell
    resource: "npm audit --prefix * --omit=dev"
    effect: allow
  - action: shell
    resource: "npm audit --prefix * * *"
    effect: deny
  - action: shell
    resource: "govulncheck -C * ./..."
    effect: allow
  - action: shell
    resource: "govulncheck -C -*"
    effect: deny
  - action: shell
    resource: "govulncheck -C * * ./..."
    effect: deny
  # For every command: no redirects, and nothing zsh would expand into
  # something else (quotes, $, braces, parentheses for =(…) and *(e:…:),
  # backslashes, tabs). OpenCode checks each subcommand of a compound
  # command separately, so chaining is covered.
  - action: shell
    resource: "*>*"
    effect: deny
  - action: shell
    resource: "*<*"
    effect: deny
  - action: shell
    resource: "*'*"
    effect: deny
  - action: shell
    resource: "*\"*"
    effect: deny
  - action: shell
    resource: "*$*"
    effect: deny
  - action: shell
    resource: "*`*"
    effect: deny
  - action: shell
    resource: "*{*"
    effect: deny
  - action: shell
    resource: "*(*"
    effect: deny
  - action: shell
    resource: "*\\*"
    effect: deny
  - action: shell
    resource: "*\t*"
    effect: deny
---

