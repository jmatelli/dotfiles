{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight-transparent"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "plugins": [
    "-opencode.sidebar.context",
    "-opencode.sidebar.mcp"
  ],
  "keybinds": {
    "session.new": "<leader>n,ctrl+t",
    "variant.cycle": "<leader>v",
    "session.tab.close": "<leader>w,ctrl+w",
    "input.delete.word.backward": "ctrl+backspace,alt+backspace"
  }
}
